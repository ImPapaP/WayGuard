# ---------------------------------------------------------------
# Wayguard environment configuration
# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored. Never commit real passwords or keys.
# ---------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Web server
HOST=0.0.0.0
PORT=3000
# Public URL people use to open Wayguard (used in e-mail links)
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL connection (create the database first, see README)
DATABASE_URL=postgres://wayguard:CHANGE_ME_DB_PASSWORD@localhost:5432/wayguard
# Separate database used by `npm test` (its tables are wiped on every run)
TEST_DATABASE_URL=postgres://wayguard:CHANGE_ME_DB_PASSWORD@localhost:5432/wayguard_test

# Sessions
SESSION_TTL_DAYS=7
# auto = secure cookies only when NODE_ENV=production or HTTPS is enabled
COOKIE_SECURE=auto
# Set to true only when running behind a reverse proxy (nginx, Render, etc.)
TRUST_PROXY=false

# Where uploaded photos are stored (private; never served directly).
# PHOTO_STORAGE=database keeps them in PostgreSQL instead, for hosting whose
# disk is wiped on restart (e.g. Render free; set in render.yaml).
PHOTO_STORAGE=disk
UPLOAD_DIR=./server/storage/uploads

# One-time creation of the first administrator when the server starts, for
# hosting without a command line. Ignored once an administrator exists; the
# password must be changed at first sign-in. Remove the password afterwards.
# Locally, use `npm run create-admin` instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=
MAX_PHOTO_MB=8

# ---- Maps -----------------------------------------------------------------
# MAP_PROVIDER chooses the map on every page:
#   vector  (default) Wayguard's Waze-style road map: MapLibre GL draws
#           OpenStreetMap vector tiles from OpenFreeMap (free, no key, no
#           sign-up, covers the whole Philippines). Needs WebGL.
#   google  Google Maps (default when GOOGLE_MAPS_API_KEY is set)
#   osm     classic OpenStreetMap raster tiles (TILE_URL below)
# If the chosen map cannot load, pages fall back to `osm` automatically.
MAP_PROVIDER=
# Vector map sources (OpenMapTiles schema). Defaults: OpenFreeMap.
MAP_VECTOR_TILEJSON_URL=https://tiles.openfreemap.org/planet
MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# MAP_VECTOR_ATTRIBUTION=  (HTML; defaults to the OpenFreeMap/OpenMapTiles/OpenStreetMap credit)

# ---- Google Maps (optional) -------------------------------------------
# With GOOGLE_MAPS_API_KEY set, every map uses Google Maps (Maps JavaScript
# API). Without it, or if Google Maps fails to load, maps use the
# OpenStreetMap tiles below. Setup steps: docs/08-deployment.md section 8.2.
# This "browser key" is sent to visitors' browsers by design, so in Google
# Cloud Console restrict it to your site's address (HTTP referrers) and to
# the Maps JavaScript API only. Never put an unrestricted key here.
GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud Console > Google Maps Platform > Map management),
# needed for Advanced Markers. Empty = Google's DEMO_MAP_ID, fine for testing.
GOOGLE_MAPS_MAP_ID=

# Raster map tiles (OpenStreetMap-compatible), used for MAP_PROVIDER=osm and
# as the automatic fallback. The public OSM tile server is free
# for light use only: https://operations.osmfoundation.org/policies/tiles/
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
TILE_MAX_ZOOM=19

# Address search / reverse geocoding (Nominatim). Requests are cached and
# throttled to 1 per second per the Nominatim usage policy:
# https://operations.osmfoundation.org/policies/nominatim/
GEOCODER_ENABLED=true
GEOCODER_URL=https://nominatim.openstreetmap.org
# A real contact e-mail is required by the Nominatim usage policy
GEOCODER_EMAIL=your-team-email@example.com
GEOCODER_COUNTRY_CODES=ph
# Address search provider: nominatim (default) or google. Google needs a
# SEPARATE server-side key with the Geocoding API enabled, restricted to your
# server's IP address; it is never sent to browsers. Google's terms only allow
# Geocoding results to be shown with a Google map, so use it together with
# GOOGLE_MAPS_API_KEY.
GEOCODER_PROVIDER=nominatim
GOOGLE_GEOCODING_API_KEY=

# Optional e-mail notifications. Leave SMTP_HOST empty to disable e-mail;
# in-app notifications always work.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS when offered (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Wayguard <no-reply@example.com>

# Optional HTTPS (needed for GPS on phones when testing over your LAN).
# Point these at a key/certificate pair, e.g. created with mkcert.
HTTPS_KEY_FILE=
HTTPS_CERT_FILE=

# Demo data only (used by `npm run db:seed`, refused when NODE_ENV=production).
# All demo accounts get this password. Use 10+ characters.
SEED_DEMO_PASSWORD=
