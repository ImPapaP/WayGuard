{
  "name": "wayguard",
  "version": "1.0.0",
  "private": true,
  "description": "Wayguard — Road Pothole Reporting and Monitoring System (IT 305 final project)",
  "license": "UNLICENSED",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm install && npm run db:migrate && npm run build",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w client",
    "build:preview": "npm run build:preview -w client",
    "start": "npm start -w server",
    "db:migrate": "npm run migrate -w server",
    "db:seed": "npm run seed -w server --",
    "db:seed:auto": "npm run seed:auto -w server",
    "create-admin": "npm run create-admin -w server --",
    "test": "npm test -w server",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:map": "node tests/e2e/vector-map.mjs",
    "test:e2e:google": "node tests/e2e/google-maps.mjs",
    "first-run": "node scripts/first-run.mjs",
    "create-platform-admin": "npm run create-platform-admin -w server --"
  }
}
